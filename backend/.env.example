# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://badal:badal@localhost:5432/badal_exchange

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_a_different_64_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Secrets encryption (payment integration credentials) ---
# Generate with: openssl rand -hex 32 (must decode to exactly 32 bytes)
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_chars

# --- CORS ---
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173
