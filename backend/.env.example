# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://badal:badal@localhost:5432/badal_exchange
# Supabase: use the project's Session pooler (port 5432) or Direct
# connection string from Project Settings -> Database, e.g.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ -> %40, # -> %23, ...).
#
# SSL: auto (default) = on for any non-localhost host, off for localhost.
# require = encrypted, certificate not verified. verify = encrypted and
# verified against DATABASE_SSL_CA (PEM text or a file path, e.g. Supabase's
# prod-ca-2021.crt). disable = off.
DATABASE_SSL=auto
DATABASE_SSL_CA=
# Max connections the backend opens. Keep it under your Supabase plan's
# pooler limit.
DATABASE_POOL_MAX=20

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_a_different_64_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Secrets encryption (payment integration credentials) ---
# Generate with: openssl rand -hex 32 (must decode to exactly 32 bytes)
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_hex_chars

# --- CORS ---
# Browser origin allowed by CORS. Only browser clients need this; the
# mobile apps don't. The old admin dashboard was removed (management is in
# the Agent App), so this is only for any future web client.
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173

# --- MobCash browser automation (optional) ---
# Path to a Chromium executable for the MobCash automation adapter
# (mobcashAutomation.ts). Only needed if an admin turns automation_mode
# to 'automatic' on the mobcash_winwin payment integration. If unset,
# playwright-core falls back to its own bundled-browser resolution, which
# requires running `npx playwright install chromium` first.
MOBCASH_CHROMIUM_PATH=
