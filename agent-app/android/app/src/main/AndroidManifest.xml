<?xml version="1.0" encoding="utf-8"?>
<!--
  Badal Exchange — Agent app manifest.

  RECEIVE_SMS / READ_SMS are runtime-dangerous permissions on Android 6+:
  declaring them here only makes the app *eligible* to request them — the
  actual grant happens via a runtime permission prompt (see
  lib/sms/sms_bridge.dart, which uses permission_handler to request
  Permission.sms). These permissions — and the SmsReceiver below — must
  only ever be exercised on a device that has been registered as an
  authorized agent device via POST /agent/devices/register. This is the
  agent-only build of Badal Exchange; the customer app must never declare
  or request these permissions.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Resolves which SIM slot a payment SMS arrived on (dual-SIM phones). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Exchange payouts: dial the carrier's USSD transfer on the payout SIM
         and keep the screen on while its reply dialog is read. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Badal Exchange Agent"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          Receives android.provider.Telephony.SMS_RECEIVED broadcasts.
          High priority so this app sees the SMS promptly; it never
          aborts the broadcast, so other SMS apps (including the default
          messaging app) still receive and display it normally — this app
          only reads it to detect authorized EVC Plus payment
          notifications, it does not intercept or hide SMS from the agent.
          Every SMS is passed to Dart, where lib/sms/payment_sms_parsers.dart
          keeps only payment SMS; everything else is dropped on the device.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          Exchange payout automation (port of Dalab Internet's
          ExchangeUssdAccessibilityService): reads and drives the carrier's
          USSD reply dialog during a payout, and does nothing otherwise. The
          agent turns it on in Settings > Accessibility.
        -->
        <service
            android:name=".payout.PayoutAccessibilityService"
            android:exported="false"
            android:label="Baari exchange payouts"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/payout_accessibility_service_config" />
        </service>

    </application>

    <!-- Required to query text processing activities on Android 11+ (Flutter default). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- url_launcher: open contact links (WhatsApp, Facebook, Telegram) on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
